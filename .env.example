# ==============================================================================
# MEMO Production Environment Configuration
# Tailored for Hostinger VPS (KVM 2) with Multi-site support
# ==============================================================================

# Django Core
DJANGO_SETTINGS_MODULE=config.settings.production
SECRET_KEY=change-this-to-a-very-long-random-secret-key-in-production
# Public domain after DNS and host Nginx/HTTPS are configured.
PUBLIC_ORIGIN=https://memo-eg.io
ALLOWED_HOSTS=memo-eg.io,www.memo-eg.io
CSRF_TRUSTED_ORIGINS=https://memo-eg.io,https://www.memo-eg.io

# Port configuration:
# Use 8001 by default so another website or a main reverse proxy (e.g. Nginx/Traefik)
# can run on port 80/443 without conflict.
# If this is your ONLY website, you can set MEMO_PORT=80.
MEMO_PORT=8001
# Host-level Nginx terminates HTTPS and proxies to this port.
# Use 0.0.0.0 only when this container must be reached directly from outside.
MEMO_BIND_IP=127.0.0.1

# Gunicorn configuration
GUNICORN_WORKERS=3
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=60

# Email SMTP Settings (For customer receipts & password reset)
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=587
EMAIL_HOST_USER=notifications@yourdomain.com
EMAIL_HOST_PASSWORD=your-email-password
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=MEMO <notifications@yourdomain.com>

# Official Meta WhatsApp Cloud API (outbound order confirmations)
WHATSAPP_PROVIDER=meta
WHATSAPP_API_ENABLED=true
WHATSAPP_PHONE_NUMBER_ID=1401557606367251
WHATSAPP_BUSINESS_ACCOUNT_ID=2209151516615984
WHATSAPP_ACCESS_TOKEN=PUT_THE_META_ACCESS_TOKEN_HERE
WHATSAPP_APP_SECRET=PUT_THE_META_APP_SECRET_HERE
WHATSAPP_VERIFY_TOKEN=generate-a-long-random-webhook-verification-token
WHATSAPP_GRAPH_API_VERSION=v23.0
WHATSAPP_TEST_MODE=true
WHATSAPP_TEST_RECIPIENT=
WHATSAPP_TEMPLATE_NAME=hello_world
WHATSAPP_TEMPLATE_LANGUAGE=en_US
WHATSAPP_HTTP_TIMEOUT=15

# Retained legacy Evolution API integration (inbound replies/admin flows)
EVOLUTION_API_URL=http://evolution:8080
EVOLUTION_API_KEY=generate-a-long-random-api-key
EVOLUTION_INSTANCE=memo-store
EVOLUTION_CREATE_INSTANCE=1
EVOLUTION_WEBHOOK_SECRET=generate-a-random-secret-with-at-least-32-characters
# Internal callback; it does not change when the public domain changes.
EVOLUTION_WEBHOOK_URL=http://web:8000/api/whatsapp/webhook/
# Use reliable numeric replies (1/2/3); Evolution/Baileys buttons are disabled.
EVOLUTION_USE_BUTTONS=0
# Configure the instance webhook automatically when the app container starts.
EVOLUTION_AUTO_CONFIGURE_WEBHOOK=1
EVOLUTION_HTTP_TIMEOUT=15
EVOLUTION_CONFIRMATION_MAX_AGE_SECONDS=604800

# Evolution infrastructure
EVOLUTION_IMAGE=evoapicloud/evolution-api:v2.3.6
EVOLUTION_DB_PASSWORD=generate-a-long-random-database-password
EVOLUTION_BIND_IP=127.0.0.1
EVOLUTION_PORT=8080

# Store Information
STORE_NAME=MEMO
