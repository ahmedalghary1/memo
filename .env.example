# ==============================================================================
# MEMO Production Environment Configuration
# Tailored for Hostinger VPS (KVM 2) with Multi-site support
# ==============================================================================

# Django Core
DJANGO_SETTINGS_MODULE=config.settings.production
SECRET_KEY=change-this-to-a-very-long-random-secret-key-in-production
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
SECURE_SSL_REDIRECT=1

# Port configuration:
# Use 8001 by default so another website or a main reverse proxy (e.g. Nginx/Traefik)
# can run on port 80/443 without conflict.
# If this is your ONLY website, you can set MEMO_PORT=80.
MEMO_PORT=8001

# Database path inside the container persistent volume
DB_PATH=/app/data/db.sqlite3

# Gunicorn configuration
GUNICORN_WORKERS=3
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=60

# Email SMTP Settings (For customer receipts & password reset)
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=587
EMAIL_HOST_USER=notifications@yourdomain.com
EMAIL_HOST_PASSWORD=your-email-password
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=MEMO <notifications@yourdomain.com>

# WhatsApp Confirmation (Evolution API v2 - Optional)
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
EVOLUTION_WEBHOOK_SECRET=
EVOLUTION_HTTP_TIMEOUT=15
EVOLUTION_CONFIRMATION_MAX_AGE_SECONDS=604800

# Store Information
STORE_NAME=MEMO
