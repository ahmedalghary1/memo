# ==============================================================================
# MEMO Production Environment Configuration
# Tailored for Hostinger VPS (KVM 2) with Multi-site support
# ==============================================================================

# Django Core
DJANGO_SETTINGS_MODULE=config.settings.production
SECRET_KEY=change-this-to-a-very-long-random-secret-key-in-production
# Temporary: http://SERVER_IP:8001
# Later change this one value to: https://yourdomain.com
PUBLIC_ORIGIN=http://179.198.215.77:8001

# Port configuration:
# Use 8001 by default so another website or a main reverse proxy (e.g. Nginx/Traefik)
# can run on port 80/443 without conflict.
# If this is your ONLY website, you can set MEMO_PORT=80.
MEMO_PORT=8001
# Keep 127.0.0.1 when a host-level Nginx/Traefik terminates HTTPS.
# Use 0.0.0.0 only when this container must be reached directly from outside.
MEMO_BIND_IP=0.0.0.0

# Gunicorn configuration
GUNICORN_WORKERS=3
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=60

# Email SMTP Settings (For customer receipts & password reset)
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=587
EMAIL_HOST_USER=notifications@yourdomain.com
EMAIL_HOST_PASSWORD=your-email-password
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=MEMO <notifications@yourdomain.com>

# WhatsApp Confirmation (Evolution API v2, hosted in this Compose stack)
EVOLUTION_API_URL=http://evolution:8080
EVOLUTION_API_KEY=generate-a-long-random-api-key
# Required by Evolution 2.4 for headless license activation after registering
# this email once in the Evolution Manager. This is not a Meta/Cloud API value.
EVOLUTION_OPERATOR_EMAIL=you@example.com
EVOLUTION_INSTANCE=memo-store
EVOLUTION_CREATE_INSTANCE=1
EVOLUTION_WEBHOOK_SECRET=generate-a-random-secret-with-at-least-32-characters
# Internal callback; it does not change when the public domain changes.
EVOLUTION_WEBHOOK_URL=http://web:8000/api/whatsapp/webhook/
# Send confirm/edit/cancel reply buttons; failed API requests fall back to text choices.
EVOLUTION_USE_BUTTONS=1
# Configure the instance webhook automatically when the app container starts.
EVOLUTION_AUTO_CONFIGURE_WEBHOOK=1
EVOLUTION_HTTP_TIMEOUT=15
EVOLUTION_CONFIRMATION_MAX_AGE_SECONDS=604800

# Evolution infrastructure
# Evolution-only interactive buttons require 2.4.0-rc2 or newer.
# Open the Evolution Manager after the first start to activate its license.
EVOLUTION_IMAGE=evoapicloud/evolution-api:2.4.0-rc2
EVOLUTION_DB_PASSWORD=generate-a-long-random-database-password
EVOLUTION_BIND_IP=127.0.0.1
EVOLUTION_PORT=8080

# Store Information
STORE_NAME=MEMO
