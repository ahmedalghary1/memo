# Example host/container Nginx configuration after a publicly trusted IP
# certificate has been issued and mounted at /etc/letsencrypt.
# Keep the current default.conf until both certificate files exist.
upstream django_app {
    server web:8000;
    keepalive 32;
}

server {
    listen 80;
    server_name 179.198.215.77;
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
    }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    server_name 179.198.215.77;
    ssl_certificate /etc/letsencrypt/live/179.198.215.77/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/179.198.215.77/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 35M;
    location / {
        proxy_pass http://django_app;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_connect_timeout 60s;
        proxy_read_timeout 90s;
        proxy_send_timeout 90s;
    }
}
